AI_EMBEDDING_MODEL=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_SIMILARITY_THRESHOLD=0.3
# Optional: real Douyin caption import via TikHub. No key = explicitly unavailable.
TIKHUB_API_KEY=
