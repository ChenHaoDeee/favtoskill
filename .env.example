# Server only. Never prefix secrets with VITE_.
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
